# Copy to .env and fill in. .env is never committed.
# Free key: https://aistudio.google.com  (free-tier prompts may be used by Google to improve its products)
GEMINI_API_KEY=
# optional: force a model, e.g. gemini-2.5-flash (default: the newest Flash model your key can use)
GEMINI_MODEL=

# Posting to your own YouTube channel (a "Desktop app" OAuth client; see the README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
